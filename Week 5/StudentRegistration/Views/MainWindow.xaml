<Window x:Class="StudentRegistration.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="720" Width="1200"
        MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FDF2F8">

    <Window.Resources>
        <!-- ====== FORM INPUT ====== -->
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#FBCFE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#FBCFE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9D174D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ====== BUTTONS ====== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EC4899"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DB2777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FCE7F3"/>
            <Setter Property="Foreground" Value="#9D174D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBCFE8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#E11D48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BE123C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== CARDS ====== -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BE185D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#831843"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ====== HEADER ====== -->
        <Border Grid.Row="0" CornerRadius="10" Padding="18,12" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EC4899" Offset="0"/>
                    <GradientStop Color="#F472B6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="Student Registration"
                           FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Dyah Utami Kesuma Dewi - 5025241186"
                           FontSize="11" Foreground="#FCE7F3" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ====== STAT CARDS ====== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#FBCFE8"
                    BorderThickness="1" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Total Mahasiswa" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding TotalMahasiswa}" Style="{StaticResource CardValue}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#FBCFE8"
                    BorderThickness="1" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Laki-laki" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding TotalLakiLaki}" Style="{StaticResource CardValue}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="#FBCFE8"
                    BorderThickness="1" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Perempuan" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding TotalPerempuan}" Style="{StaticResource CardValue}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ====== MAIN CONTENT ====== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORM -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FBCFE8"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}"
                                   FontSize="16" FontWeight="Bold" Foreground="#831843"/>
                        <TextBlock Text="Isi data mahasiswa di bawah ini"
                                   Foreground="#9CA3AF" Margin="0,2,0,10" FontSize="11"/>

                        <TextBlock Text="NIM" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Nim, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>

                        <TextBlock Text="Nama Mahasiswa" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>

                        <TextBlock Text="Program Studi" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding DaftarProdi}" SelectedItem="{Binding Prodi}"
                                  Style="{StaticResource FormCombo}"/>

                        <TextBlock Text="Jenis Kelamin" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding DaftarGender}" SelectedItem="{Binding Gender}"
                                  Style="{StaticResource FormCombo}"/>

                        <TextBlock Text="Alamat" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Alamat, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"
                                 Height="46" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top"/>

                        <TextBlock Text="Nomor Telepon" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding NoTelepon, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>

                        <TextBlock Text="{Binding Pesan}" Foreground="#E11D48"
                                   TextWrapping="Wrap" FontSize="11" Margin="0,2,0,6"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{Binding SimpanButtonText}"
                                    Command="{Binding SimpanCommand}"
                                    Style="{StaticResource PrimaryButton}" Height="36"/>
                            <Button Grid.Column="2" Content="Reset"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="36"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- TABLE -->
            <Border Grid.Column="2" Background="White" BorderBrush="#FBCFE8"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Data Mahasiswa"
                                   FontSize="16" FontWeight="Bold" Foreground="#831843"/>
                        <TextBlock Text="{Binding JumlahData}"
                                   Foreground="#9CA3AF" Margin="0,2,0,0" FontSize="11"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <TextBox x:Name="SearchBox"
                                Text="{Binding KeywordSearch, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormInput}"
                                Margin="0"/>
                        <TextBlock Text="Cari berdasarkan NIM, Nama, atau Prodi..."
                                Foreground="#9CA3AF"
                                FontSize="12"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding MahasiswaTampil}"
                              SelectedItem="{Binding MahasiswaTerpilih}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              SelectionMode="Single"
                              RowHeight="30"
                              FontSize="12"
                              CanUserAddRows="False"
                              Background="White"
                              HorizontalGridLinesBrush="#FCE7F3"
                              RowBackground="White"
                              AlternatingRowBackground="#FDF2F8">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FCE7F3"/>
                                <Setter Property="Foreground" Value="#9D174D"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="1.2*"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*"/>
                            <DataGridTextColumn Header="Prodi" Binding="{Binding Prodi}" Width="1.8*"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="1.1*"/>
                            <DataGridTextColumn Header="No. Telepon" Binding="{Binding NoTelepon}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Edit" Command="{Binding EditCommand}"
                                Style="{StaticResource SecondaryButton}" Width="90" Height="34" Margin="0,0,8,0"/>
                        <Button Content="Hapus" Command="{Binding HapusCommand}"
                                Style="{StaticResource DangerButton}" Width="90" Height="34"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
