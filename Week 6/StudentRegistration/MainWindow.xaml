<Window x:Class="StudentRegistration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration" Height="760" Width="1320"
        MinHeight="650" MinWidth="1050" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="22" Padding="26" Margin="0,0,0,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Student Registration"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Dyah Utami Kesuma Dewi - 5025241186"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,7,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="↻   Refresh Data"
                        Background="{StaticResource RoseBrush}" Foreground="White"
                        VerticalAlignment="Center" Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <!-- Panel status -->
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F8DCE8" CornerRadius="20" Padding="23">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL MAHASISWA" FontSize="11" FontWeight="Bold"
                                   Foreground="#8F3D60"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="TotalText" Text="—" FontSize="34" FontWeight="Bold"
                                       Foreground="#672442"/>
                            <TextBlock Text=" mahasiswa" FontSize="13" VerticalAlignment="Bottom"
                                       Margin="9,0,0,7" Foreground="#8F3D60"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="56" Height="56" CornerRadius="18" Background="#FFF7FA"
                            VerticalAlignment="Center">
                        <TextBlock Text="♡" FontSize="32" Foreground="{StaticResource RoseBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="20" Padding="23">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DATABASE STATUS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Ellipse Width="9" Height="9" Fill="#38A779" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="StatusText" Text="Menunggu koneksi database"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="22" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="8,3,8,16">
                    <TextBlock Text="Daftar Mahasiswa" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Data diambil langsung dari StudentRegistrationDB"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <DataGrid x:Name="StudentDataGrid" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F5E8EE" Background="White" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#FFFAFC"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserResizeRows="False" RowHeight="45">

                    <DataGrid.Resources>
                        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="55"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="105"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="NAMA MAHASISWA" Binding="{Binding Name}" Width="165"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="PROGRAM STUDI" Binding="{Binding ProgramName}" Width="190"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="TANGGAL LAHIR"
                                            Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}" Width="125"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="ALAMAT" Binding="{Binding Address}" Width="*"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="NO. TELEPON" Binding="{Binding PhoneNumber}" Width="135"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="DIBUAT"
                                            Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="4,15,4,0">
            <TextBlock Text="Student Registration System" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="LastUpdatedText" DockPanel.Dock="Right" Text="Belum diperbarui"
                       FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>